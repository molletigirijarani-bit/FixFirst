# Copy this file to .env for local development and fill in your own values.
PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: isolated database for automated workflow tests
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/fixfirst_test
